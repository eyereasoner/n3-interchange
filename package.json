{
  "name": "n3-interchange",
  "version": "0.1.0",
  "description": "Notation3 interchange for eyemind: compile N3 rules and data to eyemind programs and write their conclusions back as N3.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": "./src/index.mjs",
  "bin": {
    "n3-to-eyemind": "./bin/n3-to-eyemind.js",
    "eyemind-to-n3": "./bin/eyemind-to-n3.js",
    "eyemind-n3": "./bin/eyemind-n3.js"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "MAPPING.md",
    "bin",
    "src",
    "examples",
    "test"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "corpus": "node tools/corpus.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Jos De Roo",
  "dependencies": {
    "eyemind": "^0.4.0"
  }
}
